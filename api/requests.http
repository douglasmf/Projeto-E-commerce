# ⚠️ COPIE O TOKEN DAQUI E COLE ABAIXO
###############################################

@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoiYWRtaW5AZW1haWwuY29tIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzc4NDg4MTY0LCJleHAiOjE3Nzg1NzQ1NjR9.V7EENYkheIsP3l49g_aFtGceehdhtycRuKoMfnUTYTw

