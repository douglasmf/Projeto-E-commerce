###############################################
# BASE URL
###############################################
@baseUrl = http://localhost:3000

###############################################
# 1. REGISTER (criar usuário)
###############################################
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "DouglasM",
  "email": "admin@email.com",
  "password": "12345678"
}

###

###############################################
# 2. LOGIN ADMIN
###############################################
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@email.com",
  "password": "12345678"
}

###
###############################################
# 2.2 LOGIN USER COMUM
###############################################
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "douglasM@email.com",
  "password": "87654321"
}

